@tailwind base;
@tailwind components;
@tailwind utilities;

/* === MRDELIVERY LAB - DESIGN FUTURISTIC === */

:root {
  --background: 220 25% 4%;
  --foreground: 0 0% 98%;
  --card: 220 20% 8%;
  --card-foreground: 0 0% 98%;
  --primary: 25 95% 53%;
  --primary-foreground: 0 0% 100%;
  --secondary: 270 60% 55%;
  --secondary-foreground: 0 0% 98%;
  --muted: 220 15% 15%;
  --muted-foreground: 220 10% 60%;
  --accent: 320 80% 60%;
  --border: 220 15% 18%;
  --input: 220 15% 18%;
  --ring: 25 95% 53%;
  --radius: 0.75rem;
}

* {
  border-color: hsl(var(--border));
}

body {
  background-color: hsl(var(--background));
  color: hsl(var(--foreground));
  font-family: Inter, system-ui, -apple-system, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

/* === SCÂNTEI ANTIGRAVITAȚIONALE === */
.spark-container {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.spark {
  position: absolute;
  bottom: -20px;
  width: 4px;
  height: 4px;
  background: radial-gradient(circle, #fbbf24 0%, #f97316 50%, transparent 100%);
  border-radius: 50%;
  box-shadow: 0 0 12px #f97316, 0 0 24px #fbbf24;
  opacity: 0;
  animation: spark-rise linear infinite;
}

@keyframes spark-rise {
  0% {
    bottom: -20px;
    opacity: 0;
    transform: translateX(0);
  }
  15% {
    opacity: 0.7;
  }
  85% {
    opacity: 0.3;
  }
  100% {
    bottom: 110vh;
    opacity: 0;
    transform: translateX(calc(var(--drift, 0) * 1px));
  }
}

/* === CARDURI FUTURISTICE CU LED BORDER === */
.led-card {
  position: relative;
  background: hsl(var(--card));
  backdrop-filter: blur(24px);
  border: 1px solid hsl(var(--border));
  border-radius: 1rem;
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  animation: card-float 6s ease-in-out infinite;
  overflow: hidden;
}

.led-card::before {
  content: '';
  position: absolute;
  inset: -3px;
  border-radius: 1.15rem;
  background: conic-gradient(
    from 0deg,
    transparent 0%,
    #f97316 10%,
    #fbbf24 15%,
    transparent 30%,
    transparent 100%
  );
  opacity: 0;
  transition: opacity 0.5s ease;
  z-index: -1;
  animation: led-spin 3s linear infinite;
}

.led-card:hover {
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 20px 40px rgba(249, 115, 22, 0.3), 0 0 60px rgba(251, 191, 36, 0.2);
  border-color: #f97316;
}

.led-card:hover::before,
.led-card:hover::after {
  opacity: 1;
}



@keyframes card-float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8px);
  }
}

/* === EFECTE GLOW === */
.glow-orange {
  box-shadow: 0 0 40px -10px rgba(249, 115, 22, 0.6);
}

.glow-yellow {
  box-shadow: 0 0 40px -10px rgba(251, 191, 36, 0.6);
}

.glow-pink {
  box-shadow: 0 0 40px -10px rgba(236, 72, 153, 0.6);
}

/* === TEXT GRADIENT === */
.text-gradient {
  background: linear-gradient(135deg, #f97316 0%, #fbbf24 50%, #f59e0b 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* === GLASS EFFECT === */
.glass {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 1rem;
}

.glass-strong {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(40px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 1rem;
}

/* === BUTOANE FUTURISTICE === */
.btn-scraping {
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  color: white;
  font-weight: 700;
  padding: 0.75rem 1.5rem;
  border-radius: 0.75rem;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 10px 25px -5px rgba(249, 115, 22, 0.5);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn-scraping:hover {
  background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);
  transform: translateY(-2px) scale(1.05);
  box-shadow: 0 20px 35px -5px rgba(249, 115, 22, 0.7), 0 0 30px rgba(251, 191, 36, 0.4);
}

.btn-sms {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: white;
  font-weight: 700;
  padding: 0.75rem 1.5rem;
  border-radius: 0.75rem;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.5);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn-sms:hover {
  background: linear-gradient(135deg, #059669 0%, #047857 100%);
  transform: translateY(-2px) scale(1.05);
  box-shadow: 0 20px 35px -5px rgba(16, 185, 129, 0.7), 0 0 30px rgba(52, 211, 153, 0.4);
}

/* === ANIMAȚII === */
@keyframes float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  25% {
    transform: translateY(-20px) rotate(2deg);
  }
  50% {
    transform: translateY(-10px) rotate(0deg);
  }
  75% {
    transform: translateY(-25px) rotate(-2deg);
  }
}

@keyframes levitate {
  0%, 100% {
    transform: translateY(0) translateZ(0);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
  }
  50% {
    transform: translateY(-15px) translateZ(20px);
    box-shadow: 0 25px 40px rgba(0, 0, 0, 0.2), 0 0 30px rgba(249, 115, 22, 0.3);
  }
}

@keyframes pulse-glow {
  0%, 100% {
    opacity: 0.6;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
}

.animate-float {
  animation: float 6s ease-in-out infinite;
}

.animate-levitate {
  animation: levitate 4s ease-in-out infinite;
}

.animate-pulse-glow {
  animation: pulse-glow 3s ease-in-out infinite;
}

/* === SCROLLBAR CUSTOM === */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: hsl(var(--background));
}

::-webkit-scrollbar-thumb {
  background: hsl(var(--muted));
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: hsl(var(--primary));
}

/* === RESPONSIVE === */
@media (max-width: 768px) {
  .led-card:hover {
    transform: translateY(-4px) scale(1.01);
  }
}

