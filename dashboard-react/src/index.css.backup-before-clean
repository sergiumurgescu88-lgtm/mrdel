  inset: -4px;
  border-radius: 1.2rem;
  background: conic-gradient(
    from 0deg,
    rgba(251, 191, 36, 0) 0%,
    rgba(251, 191, 36, 0.4) 8%,
    rgba(249, 115, 22, 1) 15%,
    rgba(251, 191, 36, 0.4) 22%,
    rgba(251, 191, 36, 0) 30%,
