  );
  opacity: 0;
  transition: opacity 0.5s ease;
  z-index: -1;
  animation: led-spin 3s linear infinite;
  filter: blur(4px);
}

.led-card::after {
  content: '';
  position: absolute;
  inset: -8px;
  border-radius: 1.4rem;
  background: conic-gradient(
    from 0deg,
    rgba(249, 115, 22, 0) 0%,
    rgba(251, 191, 36, 0.5) 10%,
    rgba(249, 115, 22, 0.8) 15%,
    rgba(251, 191, 36, 0.5) 20%,
